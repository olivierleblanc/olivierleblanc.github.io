<div class="col mb-4">
  <a href="{% if youtube.redirect %}{{ youtube.redirect }}{% else %}{{ youtube.url | relative_url }}{% endif %}">
    <div class="card h-100 hoverable">
      <div class="row no-gutters">
        {% if youtube.img %}
          <div class="col-md-6">
            {% include figure.liquid loading="eager" path=youtube.img sizes="(min-width: 768px) 156px, 50vw" alt="youtube thumbnail" class="card-img" %}
          </div>
        {% endif %}
        <div class="{% if youtube.img %}col-md-6{% else %}col-md-12{% endif %}">
          <div class="card-body">
            <h3 class="card-title">{{ youtube.title }}</h3>
            <p class="card-text">{{ youtube.description }}</p>
          </div>
        </div>
      </div>
    </div>
  </a>
</div>
