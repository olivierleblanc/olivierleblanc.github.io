<div class="col">
  <a href="{% if youtube.redirect %}{{ youtube.redirect }}{% else %}{{ youtube.url | relative_url }}{% endif %}">
    <div class="card h-100 hoverable">
      {% if youtube.img %}
        {%
          include figure.liquid
          loading="eager"
          path=youtube.img
          sizes = "250px"
          alt="youtube thumbnail"
          class="card-img-top"
        %}
      {% endif %}
      <div class="card-body">
        <p style="font-size: 0.6rem;">{{ youtube.title }}</p>
        {% comment %} <h6 class="card-title">{{ youtube.title }}</h6> {% endcomment %}
        <p class="card-text">{{ youtube.description }}</p>
      </div>
    </div>
  </a>
</div>
